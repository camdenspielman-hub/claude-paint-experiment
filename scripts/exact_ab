#!/usr/bin/env bash
# Two easel builds replay the same scenes byte for byte: for a change meant to
# keep every result (a speedup, a cleanup), not one that may move a pixel.
#
#   scripts/exact_ab <base easel> <candidate easel> [--full]
#
# Each scene is a log replayed at a small width with a set thread count by
# both builds; the PNG, the checkpoint (--checkpoint-out), what the chunks
# printed and every chunk's state digest (--state-digest, without its time)
# must be the same bytes. The scenes paint with engines 1, 3 and 9 (2, 4 and
# 5 share engine 3's kernel, 7 and 8 engine 9's): the
# old-log cases (crates/easel/tests/old_logs), and in
# scripts/tests/exact_scenes the sampler's study (brushed ground, turps,
# passes, a day and four days of waiting), its plates (loading, broken colour,
# impasto, knife, glaze, lean over fat, grounds), a mixed sitting (pencil on
# an absorbent knife ground, thinned passes, a gesture, stipple, blend, rag,
# knife, glaze, scumble, a pointed round), pastel on paper (strokes, side,
# pencil, smudge, fixative, eraser) and a raw canvas. Thread counts vary, as
# results must not depend on them. --full adds larger widths (600 to 1200 px).
#
# Both builds run with no ground cache. Two scenes at a time; about 5 minutes
# for the quick set on 4 cores, 15 with --full. A heavy job: run it inside
# scripts/lockrun. Exit 0 if every scene matches, 1 otherwise.
set -uo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
[ $# -ge 2 ] || { echo "usage: scripts/exact_ab <base easel> <candidate easel> [--full]" >&2; exit 2; }
base=$(realpath "$1") cand=$(realpath "$2") full=${3:-}
for e in "$base" "$cand"; do [ -x "$e" ] || { echo "exact_ab: no easel at $e" >&2; exit 2; }; done
work=$(mktemp -d "${TMPDIR:-/tmp}/exact-ab.XXXXXX")
trap 'rm -rf "$work"' EXIT
unset EASEL_BOX EASEL_WIDTH
export EASEL_GROUND_CACHE=off
scenes=$repo/scripts/tests/exact_scenes old=$repo/crates/easel/tests/old_logs
{
  # name, log, width, threads
  printf '%s\t%s\t%s\t%s\n' study "$scenes/study.lua" 300 2 study_t1 "$scenes/study.lua" 300 1 \
    engine3_pencil "$scenes/engine3_pencil.lua" 300 3 mix "$scenes/mix.lua" 300 2 mix_t4 "$scenes/mix.lua" 300 4 \
    paper "$scenes/paper.lua" 300 2 raw "$scenes/raw.lua" 300 2
  for p in p1_loading p2_broken p3_impasto p4_knife p5_glaze p6_leanfat p7_grounds; do
    printf '%s\t%s\t%s\t%s\n' "$p" "$scenes/$p.lua" 200 2
  done
  grep -v '^#' "$old/cases.tsv" | awk -F'\t' -v d="$old" 'NF >= 3 { print "old_" $1 "\t" d "/" $2 "\t" $3 "\t2" }'
  if [ "$full" = --full ]; then
    printf '%s\t%s\t%s\t%s\n' study_1200 "$scenes/study.lua" 1200 4 mix_900 "$scenes/mix.lua" 900 4 \
      p2_broken_600 "$scenes/p2_broken.lua" 600 4 p5_glaze_600 "$scenes/p5_glaze.lua" 600 3 \
      engine3_pencil_1200 "$scenes/engine3_pencil.lua" 1200 4
  fi
} >"$work/list"
one() {
  local which=$1 easel=$2 name=$3 log=$4 width=$5 threads=$6 d="$work/$1/$3"
  mkdir -p "$d" && cd "$d" || return
  RAYON_NUM_THREADS=$threads "$easel" run "$log" --width "$width" --out out.png --checkpoint-out out.ckpt --state-digest out.dig >stdout 2>stderr
  {
    echo "exit $?"
    for f in out.png out.ckpt stdout; do echo "$f $(shasum -a 256 <"$f" 2>/dev/null | cut -d" " -f1)"; done
    sed 's/ secs=[^ ]*//' out.dig 2>/dev/null
  } >fingerprint
  rm -f out.ckpt
}
export -f one; export work
while IFS=$'\t' read -r name log width threads; do
  printf '%s\0' base "$base" "$name" "$log" "$width" "$threads" cand "$cand" "$name" "$log" "$width" "$threads"
done <"$work/list" | xargs -0 -n 6 -P 2 bash -c 'one "$@"' _
failed=0 n=0
while IFS=$'\t' read -r name log width threads; do
  n=$((n + 1))
  if cmp -s "$work/base/$name/fingerprint" "$work/cand/$name/fingerprint" && grep -q '^exit 0$' "$work/base/$name/fingerprint"; then
    echo "exact_ab: $name same ($width px, $threads threads)"
  else
    echo "exact_ab: $name DIFFERS ($width px, $threads threads):"
    diff "$work/base/$name/fingerprint" "$work/cand/$name/fingerprint" | grep '^[<>]' | head -6 | sed 's/^/  /'
    grep -q '^exit 0$' "$work/base/$name/fingerprint" || { echo "  (the base build failed to replay it:)"; tail -3 "$work/base/$name/stderr" | sed 's/^/    /'; }
    failed=1
  fi
done <"$work/list"
[ $failed = 0 ] && echo "exact_ab: all $n scenes the same, byte for byte" || echo "exact_ab: DIFFERENCES"
exit $failed
